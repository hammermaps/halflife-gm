@PointClass base(Targetname, Target) size(-16 -16 -16, 16 16 16) = random_speaker : "Random Speaker (Gunman)"
[
	rsnoise(sound)          : "Sound file (rsnoise)"
	noise(sound)            : "Sound file (noise alias)"
	volume(float)           : "Volume (0.0–1.0)" : 1.0
	wait(float)             : "Base wait time (s)" : 5.0
	random(integer)         : "Random multiplier %" : 100
	attenuation(choices)    : "Sound Attenuation" : 1 =
	[
		0 : "Everywhere (ATTN_NONE, no attenuation)"
		1 : "Normal (ATTN_NORM)"
		2 : "Idle / Short range (ATTN_IDLE)"
		3 : "Static / Very short range (ATTN_STATIC)"
