@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_houndeye_gm : "Houndeye (Gunman variant)"
[
	body(Choices) : "Body" : 0 =
	[
		0 : "Normal"
		1 : "Armored"
	]
]

@PointClass base(Monster) size(-32 -32 0, 32 32 64) = monster_dinnerjacket : "Dinnerjacket (Gunman)"
[
	body(Choices) : "Body" : 0 =
	[
		0 : "Normal"
		1 : "Heavy"
	]
]

@PointClass base(Monster) size(-128 -128 0, 128 128 256) = monster_geneworm : "Gene Worm (Gunman)"
[
	health(integer) : "Health" : 500
]

@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_xenome : "Xenome (Gunman)" []

@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_shockroach : "Shock Roach (Gunman)" []

@PointClass base(Monster) size(-32 -32 0, 32 32 128) = monster_massasaur : "Massasaur (Gunman)"
[
	body(Choices) : "Body" : 0 =
	[
		0 : "Normal"
		1 : "Alpha"
	]
]

// -------------------------------------------------------
// Stub monster entries — classnames used in stock GC maps
// but not yet fully implemented in C++.  Each stub removes
// itself immediately on spawn; entries here make Hammer
// aware of the classname so it does not report an error.
// -------------------------------------------------------

@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_human_bandit    : "Human Bandit (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_human_gunman    : "Human Gunman (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_human_demoman   : "Human Demoman (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_human_scientist : "Human Scientist (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_human_unarmed   : "Human Unarmed (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_human_chopper   : "Human Chopper (stub)" []

@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_beak        : "Beak (stub)" []
@PointClass base(Monster) size(-32 -32 0, 32 32 72) = monster_raptor      : "Raptor (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_microraptor : "Micro Raptor (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_rustbit     : "Rustbit (stub)" []
@PointClass base(Monster) size(-32 -32 0, 32 32 72) = monster_rustbot     : "Rustbot (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_rustflier   : "Rustflier (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_rustgunr    : "Rustgunr (stub)" []

@PointClass base(Monster) size(-24 -24 0, 24 24 48) = monster_scorpion      : "Scorpion (stub)" []
@PointClass base(Monster) size(-48 -48 0, 48 48 64) = monster_largescorpion : "Large Scorpion (stub)" []

// monster_sentry is the real Half-Life sentry turret (CSentry in turret.cpp)
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_sentry      : "Sentry Turret" []
@PointClass base(Monster) size(-8 -8 0, 8 8 36)    = monster_sentry_mini : "Sentry Mini (stub)" []

@PointClass base(Monster) size(-32 -32 0, 32 32 128) = monster_tube      : "Tube (stub)" []
@PointClass base(Monster) size(-64 -64 0, 64 64 256) = monster_tubequeen : "Tube Queen (stub)" []

@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_aigirl   : "AI Girl (stub)" []
@PointClass base(Monster) size(-32 -32 0, 32 32 96) = monster_ourano   : "Ourano (stub)" []
@PointClass base(Monster) size(-32 -32 0, 32 32 96) = monster_renesaur : "Renesaur (stub)" []
@PointClass base(Monster) size(-64 -64 0, 64 64 256) = monster_endboss : "End Boss (stub)" []
@PointClass base(Monster) size(-32 -32 0, 32 32 48) = monster_gator    : "Gator (stub)" []

// monster_furniture is the real Half-Life scripted sequence prop (CFurniture in scripted.cpp)
@PointClass base(Monster) size(-32 -32 0, 32 32 72) = monster_furniture    : "Scripted Furniture Prop" []
@PointClass base(Monster) size(-8 -8 0, 8 8 16)     = monster_targetrocket : "Target Rocket (stub)" []
@PointClass base(Monster) size(-32 -32 0, 32 32 64) = monster_trainingbot  : "Training Bot"
[
	model(studio) : "Model" : "models/batterybot.mdl"
	netname(string) : "Display Name" : "Training Bot"
	isUsingOspreyMovement(choices) : "Movement Mode" : 0 =
	[
		0 : "Linear (constant speed from entity pev->speed)"
		1 : "Spline (osprey-style; speed taken from each path_corner, falls back to entity speed)"
	]
	spawnflags(flags) =
	[
		8    : "Not Solid (hologram)" : 0
		1024 : "No Rings (disable beam/sparkball decoration)" : 0
	]
]

@PointClass base(Monster) size(-8 -8 0, 8 8 16)  = monster_critter     : "Critter (stub)" []
@PointClass base(Monster) size(-8 -8 0, 8 8 8)   = monster_cricket     : "Cricket (stub)" []
@PointClass base(Monster) size(-8 -8 0, 8 8 8)   = monster_dragonfly   : "Dragonfly (stub)" []
@PointClass base(Monster) size(-8 -8 0, 8 8 16)  = monster_flashlight  : "Flashlight (stub)" []
@PointClass base(Monster) size(-8 -8 0, 8 8 16)  = monster_hatchetfish : "Hatchetfish (stub)" []
@PointClass base(Monster) size(-4 -4 0, 4 4 8)   = monster_maggot      : "Maggot (stub)" []
@PointClass base(Monster) size(-8 -8 0, 8 8 8)   = monster_darttrap    : "Dart Trap (stub)" []

@PointClass base(Monster) size(-8 -8 0, 8 8 16)  = monster_xenome_embryo : "Xenome Embryo (stub)" []
@PointClass base(Monster) size(-8 -8 0, 8 8 16)  = monster_tube_embryo   : "Tube Embryo (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 48) = monster_beakbirther : "Beak Birther (stub)" []

@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_gunner_friendly  : "Friendly Gunner (stub)" []
@PointClass base(Monster) size(-16 -16 0, 16 16 72) = monster_rustbit_friendly : "Friendly Rustbit (stub)" []
@PointClass base(Monster) size(-32 -32 0, 32 32 72) = monster_rustbot_friendly : "Friendly Rustbot (stub)" []

//
// Gunman Chronicles Environmental Effects
//

@PointClass base(Targetname, Target) size(-16 -16 -16, 16 16 16) color(255 128 0) = env_smoketrail : "Smoke Trail (Gunman)"
[
	spritename(string) : "Sprite Name" : "sprites/smoke.spr"
	framerate(integer) : "Framerate" : 10
	lifetime(string) : "Lifetime" : "5"
	startsize(integer) : "Start Size" : 10
	endsize(integer) : "End Size" : 30
	rendercolor(color255) : "Color (R G B)" : "255 255 255"
	renderamt(integer) : "Brightness (0-255)" : 255
	spawnflags(Flags) =
	[
		1 : "Start On" : 0
	]
]

@PointClass base(Targetname, Target) size(-16 -16 -16, 16 16 16) color(0 128 255) = env_electrified : "Electrified Surface (Gunman)"
[
	dmg(integer) : "Damage" : 10
	wait(string) : "Damage Delay" : "1.0"
	spawnflags(Flags) =
	[
		1 : "Start On" : 1
		2 : "Toggle" : 0
	]
]

@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) color(255 0 0) = env_explosion_gm : "Explosion (Gunman variant)"
[
	iMagnitude(Integer) : "Magnitude" : 100
	iRadiusOverride(integer) : "Radius Override" : 0
	sprite(sprite) : "Sprite Name" : "sprites/zerogxplode.spr"
	spriteScale(integer) : "Sprite Scale (0=auto from magnitude)" : 0
	rendermode(choices) : "Render Mode" : 5 =
	[
		0: "Normal"
		5: "Additive"
	]
	spawnflags(Flags) =
	[
		1 : "No Damage" : 0
		2 : "Repeatable" : 0
		4 : "No Fireball" : 0
		8 : "No Smoke" : 0
		16 : "No Decal" : 0
		32 : "No Sparks" : 0
	]
]

@PointClass base(Targetname, Angles) size(-16 -16 -16, 16 16 16) color(255 255 0) = env_xenmaker : "Xen Plant Maker (Gunman)"
[
	monstertype(string) : "Monster Type" : "monster_xenome"
	monstercount(integer) : "Number of Monsters" : 1
	m_flDelay(string) : "Delay between spawns" : "5"
	m_iMaxLiveChildren(integer) : "Max live monsters" : 5
	netname(target_destination) : "Target On Spawn"
	spawnflags(Flags) =
	[
		1 : "Start On" : 0
		2 : "Cyclic" : 0
	]
]

@PointClass base(Targetname) size(-16 -16 -16, 16 16 16) = env_warpball : "Warp Ball (Gunman)"
[
	target(target_destination) : "Target"
	radius(integer) : "Radius" : 256
	duration(string) : "Duration" : "5"
	rendercolor(color255) : "Color (R G B)" : "0 255 0"
]

